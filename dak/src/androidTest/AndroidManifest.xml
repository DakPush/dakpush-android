<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The device test talks to a Dak on the computer (10.0.2.2) over http. -->
    <application
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <!-- A screen for in-app messages to show over. Exported so the test
             can bring it back from the background with `am start`. -->
        <activity
            android:name="io.github.hridoyrocks.dak.internal.InAppTestActivity"
            android:exported="true"
            android:theme="@style/DakTestTheme" />
    </application>
</manifest>
