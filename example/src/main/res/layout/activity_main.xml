<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/ask_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ask for notification permission" />

        <Switch
            android:id="@+id/subscribed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Receive pushes" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="User"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/user_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="User id"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/auth_hash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Auth hash (from your server)"
            android:importantForAutofill="no"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log in" />

            <Button
                android:id="@+id/logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log out" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tag"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/tag_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Key, like level"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/tag_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Value, like b2"
            android:importantForAutofill="no"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/set_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set tag" />

            <Button
                android:id="@+id/delete_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete tag" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="In-app messages"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Messages from the dashboard show over this screen. Set a trigger for the ones that wait for one." />

        <EditText
            android:id="@+id/trigger_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Trigger key, like screen"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/trigger_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Value, like home"
            android:importantForAutofill="no"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/add_trigger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add trigger" />

            <Button
                android:id="@+id/clear_triggers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear triggers" />
        </LinearLayout>

        <Switch
            android:id="@+id/pause_in_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pause in-app messages" />

        <Button
            android:id="@+id/open_quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open a screen without messages" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Events"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/events"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
